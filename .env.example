# Database
# Use the connection string for your local PostgreSQL or Render-managed DB
DATABASE_URL="postgresql://sage:sage@12345@localhost:5432/Intelligence-profile"

# Proxy URL (e.g., Fixie on Render)
PROXY_URL="http://proxy@proxy_host.com:80"

# Port
PORT=3000

# Node environment
NODE_ENV=development

# Logging
LOG_LEVEL=info

# Redis
REDIS_URL="redis://localhost:6379"

# Auth - GitHub
GITHUB_CLIENT_ID="your_github_client_id"
GITHUB_CLIENT_SECRET="your_github_client_secret"
GITHUB_CALLBACK_URL="http://localhost:3000/api/auth/github/callback"

# Auth - JWT
JWT_SECRET="your_very_secure_random_secret_here"
JWT_ACCESS_EXPIRATION=180
JWT_REFRESH_EXPIRATION=300

# Frontend URL for OAuth redirects and CORS
FRONTEND_URL=http://localhost:3001
