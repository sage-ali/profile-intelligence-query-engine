# Production Database (Render will inject this automatically via render.yaml)
DATABASE_URL="postgresql://user:password@host:port/dbname"

# Proxy URL (e.g., Fixie on Render)
PROXY_URL="http://fixie:n5mtYhd3N0SHZqO@ventoux.usefixie.com:80"

# Port
PORT=3000

# Node environment
NODE_ENV=production

# Logging
LOG_LEVEL=info


# Redis
REDIS_URL="redis://localhost:6379"

# Auth - GitHub
GITHUB_CLIENT_ID="your_github_client_id"
GITHUB_CLIENT_SECRET="your_github_client_secret"
GITHUB_CALLBACK_URL="http://localhost:3000/api/auth/github/callback"

# Auth - JWT
JWT_SECRET="your_very_secure_random_secret_here"
JWT_ACCESS_EXPIRATION=180
JWT_REFRESH_EXPIRATION=300


FRONTEND_URL=http://localhost:3001/
