// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  ANALYST
}

model User {
  id        String        @id @default(uuid()) @db.Uuid
  githubId  String        @unique
  email     String?
  name      String?
  role      Role          @default(ANALYST)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  sessions  AuthSession[]

  @@map("users")
}

model AuthSession {
  id                   String    @id @default(uuid()) @db.Uuid
  user                 User      @relation(fields: [userId], references: [id])
  userId               String    @db.Uuid
  clientType           String    // 'web' | 'cli'
  refreshTokenHash     String    @unique
  refreshTokenFamilyId String    @db.Uuid
  replacedByTokenHash  String?
  revokedAt            DateTime?
  userAgent            String?
  ipAddress            String?
  lastUsedAt           DateTime?
  expiresAt            DateTime
  createdAt            DateTime  @default(now())

  @@map("auth_sessions")
}

model Profile {
  id                  String   @id @default(uuid()) @db.Uuid
  name                String   @unique @db.VarChar(255)
  gender              String   @db.VarChar(10)
  gender_probability  Float
  age                 Int
  age_group           String   @db.VarChar(20)
  country_id          String   @db.VarChar(2)
  country_name        String   @db.VarChar(255)
  country_probability Float
  created_at          DateTime @default(now())

  @@map("profiles")
  @@index([gender])
  @@index([age_group])
  @@index([country_id])
  @@index([age])
  @@index([created_at])
  @@index([gender_probability])
  @@index([country_probability])
}
